<UserControl x:Class="YanJi.Plugin.StressTest.StressTestPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:YanJi.Plugin.StressTest"
             Background="{DynamicResource WindowBgBrush}"
             Foreground="{DynamicResource TextBrush}" FontSize="13">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20" MaxWidth="1160" HorizontalAlignment="Stretch">

            <!-- 四路监控前置；标题、核对状态和 GPU 选择分行，避免长显卡名称挤压标题。 -->
            <Border Style="{StaticResource CardBorder}" Width="Auto" CornerRadius="18"
                    Background="{DynamicResource HeroBgBrush}" Margin="0,0,0,16" Padding="20">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="40" Height="40" CornerRadius="14" Margin="0,0,14,0"
                                Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Top">
                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="星夜工坊 / 散热观测" Style="{StaticResource PageEyebrow}"
                                       FontSize="12" Foreground="{DynamicResource SecondaryAccentBrush}" TextWrapping="Wrap"/>
                            <TextBlock Text="数据监控（LibreHardwareMonitor 2 秒轮询）"
                                       Style="{StaticResource SectionTitle}" FontWeight="SemiBold" FontSize="14"
                                       Margin="0,5,0,0" TextWrapping="Wrap"/>
                            <TextBlock Text="先观察温度与功耗，再按需进行满载测试。"
                                       FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>
                    <WrapPanel Margin="0,16,0,12">
                        <TextBlock Text="核对状态：" FontWeight="SemiBold" Margin="0,0,8,4"/>
                        <TextBlock x:Name="StatusText" Text="待核对" Margin="0,0,0,4"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </WrapPanel>
                    <Border CornerRadius="14" Padding="12,10" Margin="0,0,0,14"
                            Background="{DynamicResource SubtleBgBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="GPU" Margin="0,0,12,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <!-- LHM 枚举带温度/功耗传感器的显卡；默认选择和换绑仍由原业务代码处理。 -->
                            <ComboBox x:Name="GpuBox" Grid.Column="1" Margin="0" MinHeight="32"
                                      HorizontalAlignment="Stretch" SelectionChanged="GpuBox_Changed"
                                      Visibility="Collapsed"
                                      ToolTip="选择温度/功耗监控的显卡（切换即换绑，旧曲线清空）"/>
                        </Grid>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <!-- CPU 两路保留驱动不可用叠层；图表只承载真实传感器数据。 -->
                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardBorder}"
                                CornerRadius="18" Margin="0,0,7,7" Padding="12"
                                Background="{DynamicResource SurfaceBgBrush}">
                            <Grid>
                                <views:LineChartControl x:Name="CpuTempChart" Height="160"
                                                        Title="CPU 温度" Unit="℃" SampleIntervalSeconds="2"/>
                                <StackPanel x:Name="CpuTempOverlay" Visibility="Collapsed" Margin="8"
                                            VerticalAlignment="Center" Background="{DynamicResource SurfaceBgBrush}">
                                    <TextBlock Text="传感器不可用（需 PawnIO 驱动）" FontSize="12"
                                               Foreground="{DynamicResource ChartNoDataBrush}"
                                               TextWrapping="Wrap" TextAlignment="Center"/>
                                    <Button Content="安装 PawnIO 驱动" Margin="0,8,0,0" Padding="12,6"
                                            HorizontalAlignment="Center" FontSize="12" Click="InstallPawnIo_Click"
                                            ToolTip="运行官方签名安装器（namazso，GPL-2.0）静默安装内核驱动；装后立即可用、无需重启"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CardBorder}"
                                CornerRadius="18" Margin="7,0,0,7" Padding="12"
                                Background="{DynamicResource SurfaceBgBrush}">
                            <Grid>
                                <views:LineChartControl x:Name="CpuPowerChart" Height="160"
                                                        Title="CPU 功耗" Unit="W" SampleIntervalSeconds="2"/>
                                <StackPanel x:Name="CpuPowerOverlay" Visibility="Collapsed" Margin="8"
                                            VerticalAlignment="Center" Background="{DynamicResource SurfaceBgBrush}">
                                    <TextBlock Text="传感器不可用（需 PawnIO 驱动）" FontSize="12"
                                               Foreground="{DynamicResource ChartNoDataBrush}"
                                               TextWrapping="Wrap" TextAlignment="Center"/>
                                    <Button Content="安装 PawnIO 驱动" Margin="0,8,0,0" Padding="12,6"
                                            HorizontalAlignment="Center" FontSize="12" Click="InstallPawnIo_Click"
                                            ToolTip="运行官方签名安装器（namazso，GPL-2.0）静默安装内核驱动；装后立即可用、无需重启"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardBorder}"
                                CornerRadius="18" Margin="0,7,7,0" Padding="12"
                                Background="{DynamicResource SurfaceBgBrush}">
                            <views:LineChartControl x:Name="GpuTempChart" Height="160"
                                                    Title="GPU 温度" Unit="℃" SampleIntervalSeconds="2"/>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardBorder}"
                                CornerRadius="18" Margin="7,7,0,0" Padding="12"
                                Background="{DynamicResource SurfaceBgBrush}">
                            <views:LineChartControl x:Name="GpuPowerChart" Height="160"
                                                    Title="GPU 功耗" Unit="W" SampleIntervalSeconds="2"/>
                        </Border>
                    </Grid>

                    <!-- 每路保留「指标 ← 硬件 / 传感器」来源与不可用状态。 -->
                    <Border CornerRadius="14" Padding="14,10" Margin="0,14,0,0"
                            Background="{DynamicResource SubtleBgBrush}">
                        <TextBlock x:Name="SensorHintText" TextWrapping="Wrap" FontSize="12" LineHeight="19"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Width="Auto" CornerRadius="18"
                    Margin="0,0,0,16" Padding="20">
                <StackPanel>
                    <TextBlock Text="满载测试控制" Style="{StaticResource SectionTitle}" FontSize="14"/>
                    <WrapPanel Margin="0,14,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,10">
                            <TextBlock Text="烤机模式" VerticalAlignment="Center" Margin="0,0,10,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <ComboBox x:Name="ModeBox" Width="130" Margin="0" MinHeight="34" SelectedIndex="2">
                                <ComboBoxItem Content="CPU 单烤" Tag="Cpu"/>
                                <ComboBoxItem Content="GPU 单烤" Tag="Gpu"/>
                                <ComboBoxItem Content="双烤" Tag="Both"/>
                            </ComboBox>
                        </StackPanel>
                        <Button x:Name="StartButton" Content="开始烤机" Style="{StaticResource PrimaryButton}"
                                Margin="0,0,8,10" FontSize="13" FontWeight="SemiBold" Padding="16,9"
                                Click="StartButton_Click"
                                ToolTip="按所选模式启动 prime95 和/或 FurMark（会另起窗口）"/>
                        <Button x:Name="StopButton" Content="停止" Margin="0,0,14,10" IsEnabled="False"
                                FontSize="13" Padding="16,9" Click="StopButton_Click"
                                ToolTip="结束全部烤机进程"/>
                        <Border CornerRadius="12" Padding="12,9" Margin="0,0,0,10"
                                Background="{DynamicResource SubtleBgBrush}">
                            <TextBlock x:Name="ElapsedText" Text="未在烤机"
                                       Foreground="{DynamicResource SecondaryAccentBrush}"/>
                        </Border>
                    </WrapPanel>
                    <Border CornerRadius="14" Padding="14,12" Margin="0,2,0,0"
                            Background="{DynamicResource AccentSoftBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{DynamicResource AccentBrush}" Margin="0,2,10,0"
                                       VerticalAlignment="Top"/>
                            <TextBlock x:Name="RunStateText" Grid.Column="1"
                                       Text="尚未烤过机；烤机会让硬件满载发热，请留意温度与风扇状态"
                                       TextWrapping="Wrap" FontSize="13" LineHeight="20"
                                       Foreground="{DynamicResource TextBrush}"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 保留只读日志、自动滚底和 500 条上限；不改变原业务代码。 -->
            <Border Style="{StaticResource CardBorder}" Width="Auto" CornerRadius="18"
                    Margin="0,0,0,16" Padding="20">
                <StackPanel>
                    <TextBlock Text="运行日志" Style="{StaticResource SectionTitle}" FontSize="14"/>
                    <Border Margin="0,12,0,0" CornerRadius="14"
                            Background="{DynamicResource SubtleBgBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <TextBox x:Name="LogBox" Height="130" Padding="12,10"
                                 IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                                 VerticalScrollBarVisibility="Auto"
                                 BorderThickness="0" Background="{DynamicResource SubtleBgBrush}"
                                 Foreground="{DynamicResource TextBrush}"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 设置纵向展开，避免窄窗口中的选项和说明被双列卡片挤压。 -->
            <Border Style="{StaticResource CardBorder}" Width="Auto" CornerRadius="18"
                    Margin="0,0,0,16" Padding="20">
                <StackPanel>
                    <TextBlock Text="FurMark 设置（GPU 烤机）" Style="{StaticResource SectionTitle}"
                               FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"/>
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="分辨率" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <ComboBox x:Name="ResolutionBox" Grid.Column="1" Margin="0,0,0,10" MinHeight="34">
                            <ComboBoxItem Content="1280 × 720" Tag="1280x720"/>
                            <ComboBoxItem Content="1600 × 900" Tag="1600x900"/>
                            <ComboBoxItem Content="1920 × 1080" Tag="1920x1080"/>
                            <ComboBoxItem Content="2560 × 1440" Tag="2560x1440"/>
                            <ComboBoxItem Content="3840 × 2160 (4K)" Tag="3840x2160" IsSelected="True"/>
                        </ComboBox>
                        <TextBlock Grid.Row="1" Text="抗锯齿" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <ComboBox x:Name="MsaaBox" Grid.Row="1" Grid.Column="1" Margin="0" MinHeight="34">
                            <ComboBoxItem Content="关闭" Tag="0" IsSelected="True"/>
                            <ComboBoxItem Content="2x MSAA" Tag="2"/>
                            <ComboBoxItem Content="4x MSAA" Tag="4"/>
                            <ComboBoxItem Content="8x MSAA" Tag="8"/>
                        </ComboBox>
                    </Grid>
                    <CheckBox x:Name="FullscreenCheck" Content="全屏烤机（Esc 或关窗退出）" Margin="0,14,0,0"/>
                    <CheckBox x:Name="FurShowUiCheck" Content="显示界面（不勾选则后台无窗口烤机）" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Width="Auto" CornerRadius="18"
                    Margin="0,0,0,16" Padding="20">
                <StackPanel>
                    <TextBlock Text="prime95 设置（CPU 烤机）" Style="{StaticResource SectionTitle}"
                               FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"/>
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="线程数" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <ComboBox x:Name="ThreadsBox" Grid.Column="1" Margin="0,0,0,10" MinHeight="34"/>
                        <TextBlock Grid.Row="1" Text="FFT 模式" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <ComboBox x:Name="FftBox" Grid.Row="1" Grid.Column="1" Margin="0" MinHeight="34" SelectedIndex="1">
                            <ComboBoxItem Content="均衡 Blend" Tag="Blend"/>
                            <ComboBoxItem Content="小 FFT（高热）" Tag="SmallHot"/>
                            <ComboBoxItem Content="大 FFT（压内存）" Tag="LargeMem"/>
                        </ComboBox>
                    </Grid>
                    <TextBlock x:Name="CoresHint" Margin="0,14,0,0" TextWrapping="Wrap" FontSize="12" LineHeight="19"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <CheckBox x:Name="P95ShowUiCheck" Content="显示界面（不勾选则后台无窗口烤机）" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Width="Auto" CornerRadius="18"
                    Background="{DynamicResource HeroBgBrush}" Margin="0" Padding="20">
                <StackPanel>
                    <TextBlock Text="人工确认散热结果" Style="{StaticResource SectionTitle}" FontSize="14"/>
                    <WrapPanel Margin="0,12,0,0">
                        <Button x:Name="PassButton" Content="确认散热合格，通过" Style="{StaticResource PrimaryButton}"
                                FontSize="13" FontWeight="SemiBold" Padding="16,9" Margin="0,0,14,6"
                                Click="PassButton_Click"
                                ToolTip="人工判断烤机过程中温度/稳定性合格后点击（会停止烤机）"/>
                        <TextBlock x:Name="PassHintText" Margin="0,0,0,6" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
