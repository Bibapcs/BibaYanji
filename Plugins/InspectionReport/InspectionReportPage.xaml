<UserControl x:Class="YanJi.Plugin.InspectionReport.InspectionReportPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource TextBrush}">
    <UserControl.Resources>
        <DataTemplate x:Key="EntryTemplate">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" VerticalAlignment="Top"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <WrapPanel x:Name="Actions" Margin="0,0,0,8">
            <Button Content="导出 PDF 验机报告" Click="Export_Click" Padding="16,7" FontWeight="SemiBold"/>
            <Button Content="复制报告摘要" Click="Copy_Click"/>
            <Button Content="打开导出目录" Click="OpenDirectory_Click"/>
            <Button Content="刷新报告" Click="Refresh_Click"/>
        </WrapPanel>
        <TextBlock x:Name="StatusText" Grid.Row="1" Margin="0,0,0,10" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="笔吧验机 · 验机报告" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock x:Name="OverviewText" Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="24"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="验机项目确认记录" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <ItemsControl x:Name="ModuleList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Status}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Passed}" Value="True">
                                                            <Setter Property="Foreground" Value="ForestGreen"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="HardwareHint" Margin="0,0,0,12" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <ItemsControl x:Name="HardwareList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <ItemsControl ItemsSource="{Binding Entries}" ItemTemplate="{StaticResource EntryTemplate}"/>
                                    <Expander Header="详细信息（会包含在报告中）" Style="{StaticResource DetailsExpander}">
                                        <ItemsControl ItemsSource="{Binding Details}" ItemTemplate="{StaticResource EntryTemplate}"/>
                                    </Expander>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="性能测试摘要" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <ItemsControl x:Name="PerformanceList" ItemTemplate="{StaticResource EntryTemplate}"/>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="NoticeText" TextWrapping="Wrap" Margin="0,0,0,16"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
