<UserControl x:Class="YanJi.Plugin.DiskMark.DiskMarkPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:YanJi.Plugin.DiskMark"
             FontSize="13" Foreground="{DynamicResource TextBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20" MaxWidth="1080">
            <Border Style="{StaticResource CardBorder}" CornerRadius="18" Margin="0,0,0,16" Padding="20"
                    Background="{DynamicResource HeroBgBrush}">
                <StackPanel>
                    <TextBlock Text="STARLIGHT WORKSHOP / STORAGE" Style="{DynamicResource PageEyebrow}"
                               FontSize="12" Foreground="{DynamicResource SecondaryAccentBrush}"/>
                    <TextBlock Text="硬盘性能测试" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,10"/>
                    <!-- 状态行：通过后变绿（通用约定） -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="测试状态：" FontWeight="SemiBold"/>
                        <TextBlock x:Name="StatusText" Text="待跑分" Margin="8,0,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 控制卡：目标盘 + 开始/取消 + 进度 -->
            <Border Style="{StaticResource CardBorder}" CornerRadius="18" Width="Auto" Margin="0" Padding="18">
                <StackPanel>
                    <TextBlock Text="测试设置" Style="{DynamicResource SectionTitle}" FontSize="14" FontWeight="SemiBold"/>
                    <WrapPanel Margin="0,10,0,0" VerticalAlignment="Center">
                        <TextBlock Text="目标盘" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <ComboBox x:Name="DriveBox" Width="90" Margin="8,0,0,0"
                                  ToolTip="CDM 在该盘创建 1 GiB 临时测速文件（测完自动删除），需要该盘根目录可写且剩余空间 &gt; 2 GiB"/>
                        <Button x:Name="RunButton" Content="开始测试" FontSize="14" FontWeight="SemiBold"
                                Style="{DynamicResource PrimaryButton}"
                                Padding="16,7" Margin="12,3,2,3" Click="RunButton_Click"
                                ToolTip="对目标盘跑 SEQ1M Q8T1 顺序读/写 + RND4K Q1T1 随机读/写四项（约 2 分钟）"/>
                        <Button x:Name="CancelButton" Content="取消" IsEnabled="False"
                                Padding="16,7" Margin="8,3,2,3" Click="CancelButton_Click"/>
                    </WrapPanel>
                    <ProgressBar x:Name="TestProgress" Height="10" Margin="0,14,0,0"
                                 VerticalAlignment="Center" Minimum="0" Maximum="100"/>
                    <TextBlock x:Name="PhaseText" Margin="0,8,0,0" TextWrapping="Wrap" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="口径：CrystalDiskMark 源码集成（引擎原封编译 + 定制 diskspd 子进程），SEQ1M Q8T1 顺序读/写 + RND4K Q1T1 随机读/写，1 GiB 随机数据 × 5 轮（+1 预热）"
                               Margin="0,12,0,0" TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="⚠ 测试期间会占满目标盘读写：请勿在该盘进行大文件操作；成绩受温度/占用影响，仅供参考对比"
                               Margin="0,6,0,0" TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- 成绩卡：两列呈现，保留四项成绩和成绩目录操作 -->
            <Border Style="{StaticResource CardBorder}" CornerRadius="18" Width="Auto" Margin="0,16,0,0" Padding="18">
                <StackPanel>
                    <TextBlock Text="测试成绩" Style="{DynamicResource SectionTitle}" FontSize="14" FontWeight="SemiBold"/>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Column="0" CornerRadius="16" Padding="14" Margin="0,0,6,6"
                                Background="{DynamicResource AccentSoftBrush}">
                            <StackPanel>
                                <TextBlock Text="顺序读取 (MB/s)" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock x:Name="ScoreSeqRead" Text="—" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" CornerRadius="16" Padding="14" Margin="6,0,0,6"
                                Background="{DynamicResource SubtleBgBrush}">
                            <StackPanel>
                                <TextBlock Text="顺序写入 (MB/s)" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock x:Name="ScoreSeqWrite" Text="—" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="0" CornerRadius="16" Padding="14" Margin="0,6,6,0"
                                Background="{DynamicResource SubtleBgBrush}">
                            <StackPanel>
                                <TextBlock Text="4K 随机读取 (MB/s)" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock x:Name="Score4KRead" Text="—" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1" CornerRadius="16" Padding="14" Margin="6,6,0,0"
                                Background="{DynamicResource SubtleBgBrush}">
                            <StackPanel>
                                <TextBlock Text="4K 随机写入 (MB/s)" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock x:Name="Score4KWrite" Text="—" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Button x:Name="OpenResultDirButton" Content="打开成绩目录" Padding="12,5" Margin="0,12,0,0"
                            FontSize="12" HorizontalAlignment="Left" Click="OpenResultDir_Click"
                            ToolTip="成绩 JSON 与成绩记录 CSV 保存在 %APPDATA%\YanJi\disk_result"/>
                    <TextBlock x:Name="DetailText" Margin="0,10,0,0" TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- 运行日志：Consolas（LogBox 惯例），自动滚底，上限 500 条；圆角 = 外套圆角 Border -->
            <Border Style="{StaticResource CardBorder}" CornerRadius="18" Width="Auto" Margin="0,16,0,0" Padding="18">
                <StackPanel>
                    <TextBlock Text="运行日志" Style="{DynamicResource SectionTitle}" FontWeight="SemiBold" FontSize="14"/>
                    <Border Margin="0,10,0,0" CornerRadius="6"
                            Background="{DynamicResource SubtleBgBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <TextBox x:Name="LogBox" Height="110" Padding="10,8"
                                 IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                                 VerticalScrollBarVisibility="Auto"
                                 BorderThickness="0" Background="{DynamicResource SubtleBgBrush}"
                                 Foreground="{DynamicResource TextBrush}"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 通过区 -->
            <Border Style="{StaticResource CardBorder}" CornerRadius="18" Margin="0,16,0,0" Padding="18"
                    Background="{DynamicResource AccentSoftBrush}">
                <StackPanel>
                    <Button x:Name="PassButton" Content="确认跑分完成，通过" HorizontalAlignment="Left"
                            Style="{DynamicResource PrimaryButton}"
                            FontSize="14" FontWeight="SemiBold" Padding="16,7" Click="PassButton_Click"
                            ToolTip="人工判断成绩合格后点击（跑分中会先取消再跳转）"/>
                    <TextBlock x:Name="PassHintText" Margin="2,8,0,0" TextWrapping="Wrap" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
