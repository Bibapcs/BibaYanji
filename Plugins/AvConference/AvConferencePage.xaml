<UserControl x:Class="YanJi.Plugin.AvConference.AvConferencePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontSize="13" Foreground="{DynamicResource TextBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20" MaxWidth="1080">
            <Border Style="{StaticResource CardBorder}" CornerRadius="18" Margin="0,0,0,16" Padding="20"
                    Background="{DynamicResource HeroBgBrush}">
                <StackPanel>
                    <TextBlock Text="STARLIGHT WORKSHOP / AUDIO &amp; VIDEO" Style="{DynamicResource PageEyebrow}"
                               FontSize="12" Foreground="{DynamicResource SecondaryAccentBrush}"/>
                    <TextBlock Text="影音设备检查" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,10"/>
                    <!-- 状态行：通过后变绿 -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="测试状态：" FontWeight="SemiBold"/>
                        <TextBlock x:Name="StatusText" Text="待测试" Margin="8,0,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ═══ 摄像头 ═══ -->
            <Border Style="{StaticResource CardBorder}" CornerRadius="18" Width="Auto" Margin="0" Padding="18">
                <StackPanel>
                    <TextBlock Text="摄像头" Style="{DynamicResource SectionTitle}" FontWeight="SemiBold" FontSize="14"/>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="设备：" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <ComboBox x:Name="CameraBox" Grid.Column="1" SelectionChanged="CameraBox_Changed"/>
                    </Grid>
                    <Border Margin="0,8,0,0" Width="480" Height="270" CornerRadius="6" ClipToBounds="True"
                            Background="{DynamicResource SubtleBgBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <Grid>
                            <Image x:Name="PreviewImage" Stretch="Uniform"/>
                            <TextBlock x:Name="CameraError" TextWrapping="Wrap" Margin="16"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="正在初始化摄像头…"/>
                        </Grid>
                    </Border>
                    <TextBlock Text="离开本页面即自动关闭摄像头（指示灯熄灭）" Margin="0,10,0,0"
                               TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- ═══ 麦克风 ═══ -->
            <Border Style="{StaticResource CardBorder}" CornerRadius="18" Width="Auto" Margin="0,16,0,0" Padding="18">
                <StackPanel>
                    <TextBlock Text="麦克风" Style="{DynamicResource SectionTitle}" FontWeight="SemiBold" FontSize="14"/>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="设备：" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <ComboBox x:Name="MicBox" Grid.Column="1" SelectionChanged="MicBox_Changed"/>
                    </Grid>
                    <ProgressBar x:Name="MicLevel" Margin="2,8" Minimum="0" Maximum="100"/>
                    <WrapPanel VerticalAlignment="Center">
                        <Button x:Name="RecordButton" Content="录制" Click="RecordButton_Click"
                                Style="{DynamicResource PrimaryButton}"
                                ToolTip="录一段麦克风输入（最长 15 秒自动停）"/>
                        <Button x:Name="PlayRecButton" Content="回放" IsEnabled="False" Click="PlayRecButton_Click"
                                ToolTip="通过下方所选扬声器回放刚录的音"/>
                    </WrapPanel>
                    <TextBlock x:Name="MicStatus" Margin="2,6,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- ═══ 扬声器 ═══ -->
            <Border Style="{StaticResource CardBorder}" CornerRadius="18" Width="Auto" Margin="0,16,0,0" Padding="18">
                <StackPanel>
                    <TextBlock Text="扬声器" Style="{DynamicResource SectionTitle}" FontWeight="SemiBold" FontSize="14"/>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="设备：" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <ComboBox x:Name="SpkBox" Grid.Column="1"/>
                    </Grid>
                    <WrapPanel Margin="0,8,0,0" VerticalAlignment="Center">
                        <Button x:Name="PlayMusicButton" Content="播放音乐" Click="PlayMusicButton_Click"
                                Style="{DynamicResource PrimaryButton}"
                                ToolTip="通过所选设备播放试音曲"/>
                    </WrapPanel>
                    <TextBlock x:Name="MusicStatus" Margin="2,6,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Margin="0,10,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="试音曲「不死のバイオレット」Copyright© 幻月遠征隊，使用已经著作权人同意。"/>
                </StackPanel>
            </Border>

            <!-- 通过按钮 -->
            <Border Style="{StaticResource CardBorder}" CornerRadius="18" Margin="0,16,0,0" Padding="18"
                    Background="{DynamicResource AccentSoftBrush}">
                <StackPanel>
                    <TextBlock Text="确认画面、录音回放与扬声器均正常后，完成本项检查。"
                               TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10"/>
                    <Button x:Name="PassButton" Content="确认无故障，通过" Click="PassButton_Click"
                            Style="{DynamicResource PrimaryButton}" HorizontalAlignment="Left"
                            FontSize="14" FontWeight="SemiBold" Padding="16,7"
                            ToolTip="摄像头有画面、麦克风有电平且录放正常、扬声器出声后点击"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
