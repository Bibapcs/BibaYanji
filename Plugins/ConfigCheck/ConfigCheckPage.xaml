<UserControl x:Class="YanJi.Plugin.ConfigCheck.ConfigCheckPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource WindowBgBrush}"
             Foreground="{DynamicResource TextBrush}" FontSize="13">
    <Grid Margin="20" MaxWidth="1160" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardBorder}" CornerRadius="18"
                Background="{DynamicResource HeroBgBrush}" Padding="20" Margin="0,0,0,16">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="14" Margin="0,0,14,0"
                            Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Top">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="星夜工坊 / 配置核对" Style="{StaticResource PageEyebrow}"
                                   FontSize="12" Foreground="{DynamicResource SecondaryAccentBrush}" TextWrapping="Wrap"/>
                        <TextBlock Text="逐项核对，确认这台设备" Style="{StaticResource SectionTitle}"
                                   FontSize="14" Margin="0,5,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="采集完成后，请将下方硬件信息与订单配置逐项核对。"
                                   FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Grid>

                <!-- 摘要和操作可随可用宽度换行，检测状态仍由原业务代码更新。 -->
                <WrapPanel Margin="0,18,0,8" VerticalAlignment="Center">
                    <Border CornerRadius="12" Padding="12,9" Margin="0,0,14,8"
                            Background="{DynamicResource SubtleBgBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="核对状态：" FontWeight="SemiBold"/>
                            <TextBlock x:Name="StatusText" Text="待检测" Margin="8,0,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="RunButton" Content="重新检测" Margin="0,0,8,8"
                            FontSize="13" FontWeight="SemiBold" Padding="16,9" Click="RunButton_Click"
                            ToolTip="重新采集 CPU / 显卡 / 内存 / 硬盘 / 屏幕 / 电池信息（会清除已通过状态）"/>
                    <Button x:Name="PassButton" Content="确认无误，通过" IsEnabled="False"
                            Style="{StaticResource PrimaryButton}" FontSize="13" Padding="16,9"
                            Margin="0,0,0,8" Click="PassButton_Click"
                            ToolTip="人工逐项核对下方信息与订单配置一致后点击"/>
                </WrapPanel>

                <Border CornerRadius="14" Padding="14,12"
                        Background="{DynamicResource SurfaceBgBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <ProgressBar x:Name="DetectProgress" Height="8" Minimum="0" Maximum="100"
                                     Foreground="{DynamicResource AccentBrush}"
                                     Background="{DynamicResource SubtleBgBrush}"/>
                        <TextBlock x:Name="PhaseText" Text="尚未检测" Margin="0,8,0,0"
                                   FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- 结果保持纵向分组；比例列宽和换行共同容纳窄窗口及较长的硬件值。 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="ResultsHost" Margin="0,0,6,0" HorizontalContentAlignment="Stretch">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}" Width="Auto" CornerRadius="18"
                                Margin="0,0,0,14" Padding="20"
                                Background="{DynamicResource SurfaceBgBrush}">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="30" Height="30" CornerRadius="10" Margin="0,0,10,0"
                                            Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Top">
                                        <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                   Foreground="{DynamicResource SecondaryAccentBrush}"
                                                   HorizontalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding Title}"
                                               Style="{StaticResource SectionTitle}" FontWeight="SemiBold"
                                               FontSize="14" TextWrapping="Wrap"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Entries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="0,9" BorderThickness="0,0,0,1"
                                                    BorderBrush="{DynamicResource BorderBrush}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2*" MaxWidth="180"/>
                                                        <ColumnDefinition Width="5*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" Margin="0,0,16,0"
                                                               VerticalAlignment="Top" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Value}"
                                                               VerticalAlignment="Top" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource TextBrush}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Expander Header="详细信息" Style="{StaticResource DetailsExpander}" Margin="0,8,0,0">
                                    <Border CornerRadius="14" Padding="14,6" Margin="0,8,0,0"
                                            Background="{DynamicResource SubtleBgBrush}">
                                        <ItemsControl ItemsSource="{Binding Details}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,7">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="2*" MaxWidth="180"/>
                                                            <ColumnDefinition Width="5*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Name}" Margin="0,0,16,0"
                                                                   VerticalAlignment="Top" TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Value}"
                                                                   VerticalAlignment="Top" TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource TextBrush}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </Expander>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
