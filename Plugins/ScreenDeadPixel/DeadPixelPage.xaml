<UserControl x:Class="YanJi.Plugin.ScreenDeadPixel.DeadPixelPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontSize="13" Foreground="{DynamicResource TextBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20" MaxWidth="1080">
            <Border Style="{StaticResource CardBorder}" CornerRadius="18" Margin="0,0,0,16" Padding="20"
                    Background="{DynamicResource HeroBgBrush}">
                <StackPanel>
                    <TextBlock Text="STARLIGHT WORKSHOP / DISPLAY" Style="{DynamicResource PageEyebrow}"
                               FontSize="12" Foreground="{DynamicResource SecondaryAccentBrush}"/>
                    <TextBlock Text="屏幕坏点检测" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,10"/>
                    <!-- 状态行：通过后变绿 -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="测试状态：" FontWeight="SemiBold"/>
                        <TextBlock x:Name="StatusText" Text="待测试" Margin="8,0,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" CornerRadius="18" Margin="0,0,0,16" Padding="18">
                <StackPanel>
                    <TextBlock Text="选择检测屏幕" Style="{DynamicResource SectionTitle}" FontSize="14" FontWeight="SemiBold"/>
                    <!-- 显示器选择与操作分行，避免窄窗口挤压 -->
                    <Grid Margin="0,10,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="显示器：" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="MonitorBox" Grid.Column="1" VerticalAlignment="Center" Margin="0,3"
                                  ToolTip="选择要做坏点检测的屏幕（多屏逐台测试）"/>
                    </Grid>
                    <WrapPanel>
                        <Button x:Name="StartButton" Content="开始测试" Click="StartButton_Click"
                                Style="{DynamicResource PrimaryButton}"
                                FontSize="14" FontWeight="SemiBold" Padding="16,7" Margin="0,3,8,3"
                                ToolTip="在所选屏幕上弹出全屏纯色窗口：白→红→绿→蓝→黑 循环"/>
                        <Button x:Name="PassButton" Content="确认无坏点，通过" Margin="0,3,0,3" Click="PassButton_Click"
                                ToolTip="各纯色下检查无坏点/亮点/暗点后点击"/>
                    </WrapPanel>
                    <TextBlock x:Name="TestingHint" Text="" TextWrapping="Wrap"
                               Foreground="{DynamicResource AccentBrush}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" CornerRadius="18" Margin="0" Padding="18"
                    Background="{DynamicResource AccentSoftBrush}">
                <StackPanel>
                    <TextBlock Text="全屏检测 · 操作指南" Style="{DynamicResource SectionTitle}" FontSize="14" FontWeight="SemiBold"/>
                    <!-- 使用说明（操作方式以这里为准：任意键/单击切换，Esc 退出） -->
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" LineHeight="22" Margin="0,10,0,0">
操作方式：点「开始测试」后，所选屏幕进入全屏纯色检测模式（白 → 红 → 绿 → 蓝 → 黑 循环）。
按任意键或单击鼠标左键 = 切换下一种颜色；Esc = 退出全屏回到本页面。
请在每种纯色下仔细观察全屏：坏点（恒黑）、亮点（恒亮/恒白）、暗点（颜色异常）在任何一种颜色下都会现形。
多屏请逐台选择测试；全部确认无异常后点「确认无坏点，通过」。
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
