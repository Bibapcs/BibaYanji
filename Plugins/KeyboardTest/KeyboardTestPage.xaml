<UserControl x:Class="YanJi.Plugin.KeyboardTest.KeyboardTestPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontSize="13" Foreground="{DynamicResource TextBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20" MaxWidth="1080">
            <Border Style="{StaticResource CardBorder}" CornerRadius="18" Margin="0,0,0,16" Padding="20"
                    Background="{DynamicResource HeroBgBrush}">
                <StackPanel>
                    <TextBlock Text="STARLIGHT WORKSHOP / KEYBOARD" Style="{DynamicResource PageEyebrow}"
                               FontSize="12" Foreground="{DynamicResource SecondaryAccentBrush}"/>
                    <TextBlock Text="键盘逐键测试" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,10"/>
                    <!-- 状态行：通过后变绿 -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="测试状态：" FontWeight="SemiBold"/>
                        <TextBlock x:Name="StatusText" Text="待测试" Margin="8,0,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" CornerRadius="18" Margin="0,0,0,16" Padding="18">
                <StackPanel>
                    <TextBlock Text="逐键检查" Style="{DynamicResource SectionTitle}" FontSize="14" FontWeight="SemiBold"/>
                    <!-- 操作行 -->
                    <WrapPanel Margin="0,10,0,12">
                        <Button x:Name="ResetButton" Content="重置" Click="ResetButton_Click"
                                ToolTip="清空所有已测试标记，重新开始"/>
                        <Button x:Name="PassButton" Content="确认无故障，通过" Margin="8,3,2,3" Click="PassButton_Click"
                                Style="{DynamicResource PrimaryButton}"
                                ToolTip="逐键按过、确认无失灵/串键后点击（笔记本没有的键保持灰色即可）"/>
                    </WrapPanel>

                    <!-- 进度行 -->
                    <ProgressBar x:Name="KeyProgress" Height="10" Minimum="0" Maximum="104"/>
                    <TextBlock x:Name="ProgressText" Text="已测试 0 / 104" Margin="0,8,0,4"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="直接按物理键盘测试；笔记本没有的键（如小键盘）保持灰色属正常"
                               TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- 键盘区：u 单位坐标在 code-behind 生成（Canvas 尺寸也在代码里设定），Viewbox 自适应缩放 -->
            <Border Style="{StaticResource CardBorder}" CornerRadius="18" Width="Auto" Margin="0" Padding="18">
                <Viewbox Stretch="Uniform">
                    <Canvas x:Name="KeyboardCanvas"/>
                </Viewbox>
            </Border>

            <!-- 按键历史 Log 区：Consolas（LogBox 惯例），自动滚底，上限 500 条；
                 圆角 = 外套圆角 Border（TextBox 本身无圆角，去边框去底色嵌进去），与分组卡片/键帽一致 -->
            <Border Style="{StaticResource CardBorder}" CornerRadius="18" Margin="0,16,0,0" Padding="18">
                <StackPanel>
                    <TextBlock Text="按键记录" Style="{DynamicResource SectionTitle}" FontSize="14" FontWeight="SemiBold"/>
                    <Border Margin="0,10,0,0" CornerRadius="6"
                            Background="{DynamicResource SubtleBgBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <TextBox x:Name="LogBox" Height="120" Padding="10,8"
                                 IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                                 VerticalScrollBarVisibility="Auto"
                                 BorderThickness="0" Background="{DynamicResource SubtleBgBrush}"
                                 Foreground="{DynamicResource TextBrush}"/>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
