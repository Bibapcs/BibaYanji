<Project>
  <!-- 主程序发布配置：自包含 win-x64（目标机无 .NET 运行时）。WPF 不支持裁剪/AOT，不要开。
       输出到仓库根 publish\（整目录拷走即用）。
       注意：FurMark 负载须先用其 FolderProfile 发到 publish-stage\furmark\，
       本配置发布后用自包含负载整体替换 Tools\furmark\（源码树 Tools/furmark 是开发期
       框架依赖负载，直接发布会带不动目标机）。 -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>$(MSBuildProjectDirectory)\..\publish\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <!-- 发布后：用 FurMark 的自包含负载整体替换 publish\Tools\furmark\。
       暂存缺失时直接报错——否则会把开发期框架依赖负载发出去（目标机没有运行时必崩） -->
  <Target Name="CopyFurMarkSelfContained" AfterTargets="Publish">
    <Error Condition="!Exists('$(MSBuildProjectDirectory)\..\publish-stage\furmark\FurMark.exe')"
           Text="缺少 publish-stage\furmark：请先执行 dotnet publish FurMark/FurMark.csproj -p:PublishProfile=FolderProfile" />
    <RemoveDir Directories="$(PublishDir)Tools\furmark" />
    <ItemGroup>
      <_FurMarkPayload Include="$(MSBuildProjectDirectory)\..\publish-stage\furmark\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_FurMarkPayload)" SkipUnchangedFiles="true"
          DestinationFiles="@(_FurMarkPayload->'$(PublishDir)Tools\furmark\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
</Project>
