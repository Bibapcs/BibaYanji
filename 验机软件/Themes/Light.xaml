<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 浅色主题语义令牌：样式一律 DynamicResource 引用这些键，不写字面颜色 -->
    <SolidColorBrush x:Key="WindowBgBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceBgBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SubtleBgBrush" Color="#F3F4F6"/>
    <SolidColorBrush x:Key="TextBrush" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6B7280"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#D9DCE1"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#B4B9C1"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#0F6CBD"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#115EA6"/>
    <SolidColorBrush x:Key="NavHoverBrush" Color="#EEF3F9"/>
    <SolidColorBrush x:Key="NavSelectedBrush" Color="#DCE9F7"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#C42B1C"/>
    <SolidColorBrush x:Key="ChartGridBrush" Color="#E6E6E6"/>
    <SolidColorBrush x:Key="ChartTextBrush" Color="#808080"/>
    <SolidColorBrush x:Key="ChartNoDataBrush" Color="#D0D0D0"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#B0B4BA"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#8B929A"/>
    <SolidColorBrush x:Key="ScrollTrackBrush" Color="#F3F4F6"/>
</ResourceDictionary>
