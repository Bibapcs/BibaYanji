<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 星夜工坊·晨光：与 Dark.xaml 键集一致。 -->
    <SolidColorBrush x:Key="WindowBgBrush" Color="#F4F3FA"/>
    <SolidColorBrush x:Key="SurfaceBgBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SubtleBgBrush" Color="#EEEDF6"/>
    <SolidColorBrush x:Key="TextBrush" Color="#262940"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#626B87"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#DCDDEA"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#959AB4"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#A83B6B"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#8C2D57"/>
    <SolidColorBrush x:Key="NavHoverBrush" Color="#F4E9F1"/>
    <SolidColorBrush x:Key="NavSelectedBrush" Color="#F5DDE9"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#B22A42"/>
    <SolidColorBrush x:Key="ChartGridBrush" Color="#E1E3EE"/>
    <SolidColorBrush x:Key="ChartTextBrush" Color="#626B87"/>
    <SolidColorBrush x:Key="ChartNoDataBrush" Color="#626B87"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#ADB2CA"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#747E9F"/>
    <SolidColorBrush x:Key="ScrollTrackBrush" Color="#EEEDF6"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#F8E4EE"/>
    <SolidColorBrush x:Key="SecondaryAccentBrush" Color="#176D79"/>
    <SolidColorBrush x:Key="AccentOnBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SidebarBgBrush" Color="#F9F8FD"/>
    <SolidColorBrush x:Key="PosterTextBrush" Color="#FFFFFF"/>
    <LinearGradientBrush x:Key="HeroBgBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F9EEF6" Offset="0"/>
        <GradientStop Color="#EAF4F7" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PosterShadeBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00131626" Offset="0.25"/>
        <GradientStop Color="#EB131626" Offset="1"/>
    </LinearGradientBrush>
</ResourceDictionary>
