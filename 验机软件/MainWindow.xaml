<Window x:Class="YanJi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="笔吧验机 · 星夜工坊" Width="1220" Height="820"
        MinWidth="1040" MinHeight="700"
        Background="{DynamicResource WindowBgBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextElement.Foreground="{DynamicResource TextBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="244"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Background="{DynamicResource SidebarBgBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="14,18,14,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Margin="8,0,4,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" CornerRadius="12" HorizontalAlignment="Left"
                            Background="{DynamicResource AccentSoftBrush}">
                        <TextBlock Text="&#xE950;" FontFamily="Segoe MDL2 Assets" FontSize="19"
                                   HorizontalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="笔吧验机" FontSize="19" FontWeight="Bold"/>
                        <TextBlock Text="星夜工坊 / STARLIGHT" FontSize="10" Margin="0,3,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1" Margin="10,0,8,8">
                    <TextBlock Text="检测项目" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="ModuleCountText" HorizontalAlignment="Right" FontSize="11"
                               Foreground="{DynamicResource SecondaryAccentBrush}"/>
                </Grid>
                <!-- 插件清单驱动导航；页面常驻，保留鼠标、键盘和通过后自动切页。 -->
                <ListBox Grid.Row="2" x:Name="NavList" SelectionChanged="OnNavSelect"
                         AutomationProperties.Name="检测项目导航" Margin="0,0,0,10"/>
                <Border Grid.Row="3" Margin="6,4,6,14" CornerRadius="16" ClipToBounds="True"
                        Background="{DynamicResource HeroBgBrush}" MinHeight="70">
                    <Grid IsHitTestVisible="False">
                        <Grid.Background>
                            <ImageBrush ImageSource="Assets/starlight-technician.jpg"
                                        Stretch="UniformToFill" AlignmentY="Top"/>
                        </Grid.Background>
                        <Border Background="{DynamicResource PosterShadeBrush}"/>
                        <StackPanel VerticalAlignment="Bottom" Margin="16,12">
                            <TextBlock Text="今晚，一起认真验机。" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PosterTextBrush}"/>
                            <TextBlock Text="STARLIGHT WORKSHOP" FontSize="9" Margin="0,5,0,0"
                                       Foreground="{DynamicResource PosterTextBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <StackPanel Grid.Row="4" Margin="10,0,10,0">
                    <Grid Margin="0,0,0,9">
                        <TextBlock Text="本次完成" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="CompletionText" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold"/>
                    </Grid>
                    <ProgressBar x:Name="CompletionProgress" Height="4" Maximum="1"/>
                    <TextBlock x:Name="AllDoneHint" Text="全部验机项目已完成" FontSize="11"
                               TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"
                               Foreground="{DynamicResource SecondaryAccentBrush}"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,17">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="STARLIGHT / 检测工作台" Style="{StaticResource PageEyebrow}"/>
                        <TextBlock x:Name="CurrentModuleText" Text="欢迎来到星夜工坊" FontSize="20"
                                   FontWeight="SemiBold" Margin="0,5,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Click="OnPluginManagerClick" Padding="13,8" Margin="0,0,18,0"
                                ToolTip="查看、导入或删除插件模块" AutomationProperties.Name="插件管理">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74C;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0"/>
                                <TextBlock Text="插件管理"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Text="&#xE706;" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="0,0,8,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <ToggleButton x:Name="ThemeSwitch" Style="{StaticResource ThemeSwitch}"
                                      ToolTip="切换星夜 / 晨光主题" AutomationProperties.Name="切换深浅主题"
                                      Checked="OnThemeSwitch" Unchecked="OnThemeSwitch"/>
                        <TextBlock Text="&#xE708;" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="8,0,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>
            <ContentControl x:Name="ContentHost" Grid.Row="1" HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"/>
            <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                    Padding="24,9" Background="{DynamicResource SubtleBgBrush}">
                <TextBlock x:Name="ModuleHintText" Text="选择左侧项目开始检测" FontSize="11"
                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondaryBrush}"/>
            </Border>
        </Grid>
    </Grid>
</Window>
