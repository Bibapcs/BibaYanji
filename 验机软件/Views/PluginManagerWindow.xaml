<Window x:Class="YanJi.Views.PluginManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="插件管理" Width="600" Height="440" MinWidth="520" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBgBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        TextElement.Foreground="{DynamicResource TextBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="已安装插件（plugins/ 目录，增删插件重启程序后生效）"
                   FontWeight="SemiBold" Margin="0,0,0,10"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="PluginList"/>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="导入插件包 (.zip)…" Click="OnImportClick" Padding="12,4"
                    ToolTip="选择 zip 插件包导入（结构见插件开发文档：plugin.json + 插件 dll），重启后生效"/>
        </StackPanel>
    </Grid>
</Window>
