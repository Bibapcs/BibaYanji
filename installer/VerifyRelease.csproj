<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PayloadDir Condition="'$(PayloadDir)' == ''">$(MSBuildThisFileDirectory)..\publish</PayloadDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="VerifyRelease.cs" />
    <Reference Include="验机软件"><HintPath>$(PayloadDir)\验机软件.dll</HintPath></Reference>
    <Reference Include="YanJi.PluginSdk"><HintPath>$(PayloadDir)\YanJi.PluginSdk.dll</HintPath></Reference>
    <Reference Include="YanJi.Plugin.ConfigCheck"><HintPath>$(PayloadDir)\plugins\config\YanJi.Plugin.ConfigCheck.dll</HintPath></Reference>
    <Reference Include="YanJi.Plugin.StressTest"><HintPath>$(PayloadDir)\plugins\stress\YanJi.Plugin.StressTest.dll</HintPath></Reference>
    <PackageReference Include="System.Management" Version="10.0.11" />
  </ItemGroup>
  <Target Name="CopyReleasePayload" AfterTargets="Build">
    <!-- Clear only the probe-owned plugin copy, never the source package. -->
    <RemoveDir Directories="$(OutDir)plugins" />
    <ItemGroup><ReleaseFiles Include="$(PayloadDir)\**\*" /></ItemGroup>
    <Copy SourceFiles="@(ReleaseFiles)" DestinationFiles="@(ReleaseFiles->'$(OutDir)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
